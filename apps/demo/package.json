{
  "name": "@electron-multi-window/demo",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "package": "bun run build && electron-builder",
    "package:dir": "bun run build && electron-builder --dir",
    "preview": "vite preview",
    "test:e2e": "vite build && playwright test",
    "test:e2e:ui": "vite build && playwright test --ui",
    "test:e2e:headless": "env -u WAYLAND_DISPLAY XDG_SESSION_TYPE=x11 xvfb-run -a bun run test:e2e"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@electron-multi-window/core": "workspace:*",
    "@playwright/test": "^1.64.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0"
  },
  "main": "dist-electron/main.js",
  "license": "ISC"
}
