{
  "name": "@electron-multi-window/core",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-window Electron building blocks: a main-process store, a window manager keyed by hash route and a typed IPC bridge.",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js"
    },
    "./main": {
      "types": "./dist/main/index.d.ts",
      "import": "./dist/main/index.js"
    },
    "./preload": {
      "types": "./dist/preload/index.d.ts",
      "import": "./dist/preload/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer/index.d.ts",
      "import": "./dist/renderer/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "electron": ">=44",
    "react": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "electron": "^44.7.0",
    "react": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "license": "ISC"
}
